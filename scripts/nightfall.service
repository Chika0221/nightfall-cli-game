[Unit]
Description=NIGHTFALL private game manager
After=local-fs.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/nightfall
ExecStart=/opt/nightfall/venv/bin/python -I -m nightfall.daemon
Restart=on-failure
UMask=0077
RuntimeDirectory=nightfall
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/contractor /srv/nightfall /var/lib/nightfall /run/nightfall
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
MemoryMax=256M
TasksMax=16

[Install]
WantedBy=multi-user.target
